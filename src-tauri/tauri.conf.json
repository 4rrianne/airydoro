{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "airydoro",
  "version": "0.1.0",
  "identifier": "com.airydoro.app",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "live-server src --port=1420 --no-browser",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "airydoro",
        "width": 350,
        "height": 450,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/tomato.ico"
    ]
  }
  
}
